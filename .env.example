# logging settings
log_level=INFO
log_file=./logs/rag.log
log_format="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# data source
data_path="./data/md/"

# embedding model
embed_url="Your embedding API URL"
embed_token="Your embedding API token"
embed_model="Your embedding model name"

# rerank model
rerank_model=maidalun1020/bce-reranker-base_v1

# chat model
chat_url="Your chat API URL"
chat_token="Your chat API token"
chat_model="Your chat model name"

# SQLite
sqlite_db_path="./data/rag.db"

# Qdrant
qdrant_path="./data/qdrant.db"
qdrant_url="http://localhost:6333"
qdrant_collection="chunks"

# Tavily
tavily_url="https://api.tavily.com/search"
tavily_token="Your Tavily API token"
